class NumberCollection:
    def __init__(self, numbers: list[int]):
        self._numbers = list(numbers)

    def get_positive_numbers(self) -> list[int]:
        return [n for n in self._numbers if n > 0]

    def get_positive_squares(self) -> list[int]:
        return [n ** 2 for n in self._numbers if n > 0]

    def sum_positive_squares(self) -> int:
        return sum(self.get_positive_squares())

    def count_positive_numbers(self) -> int:
        return len(self.get_positive_numbers())

    def find_maximum(self) -> int:
        return max(self._numbers)


collection = NumberCollection([-5, 3, 7, -2, 4, 0, 10, -1])

print("Положительные числа:", collection.get_positive_numbers())
print("Квадраты:", collection.get_positive_squares())
print("Количество положительных:", collection.count_positive_numbers())
print("Максимум:", collection.find_maximum())
print("Сумма квадратов:", collection.sum_positive_squares())

collection2 = NumberCollection([1, -3, 5, 2])
print("Второй объект, сумма квадратов:", collection2.sum_positive_squares())
