numbers = [-5, 3, 7, -2, 4, 0, 10, -1]

positive_numbers = list(filter(lambda n: n > 0, numbers))
squares = list(map(lambda n: n ** 2, positive_numbers))
result = sum(squares)

print("Положительные числа:", positive_numbers)
print("Квадраты:", squares)
print("Сумма квадратов:", result)

generator_result = sum(n ** 2 for n in numbers if n > 0)
print("Генераторное выражение:", generator_result)
