from gradebook import (
    Student,
    GradeBook,
    TextExporter,
    CsvExporter,
    MemoryExporter,
    JsonExporter
)


students = [
    Student(101, "Amina"),
    Student(102, "Dias"),
    Student(103, "Mira")
]

students[0].add_score(80)
students[0].add_score(90)

students[1].add_score(45)
students[1].add_score(55)

for exporter in (
    TextExporter(),
    CsvExporter(),
    MemoryExporter(),
    JsonExporter()
):
    book = GradeBook(exporter)

    for student in students:
        book.register(student)

    print(f"--- {exporter.__class__.__name__} ---")
    print(book.export())
